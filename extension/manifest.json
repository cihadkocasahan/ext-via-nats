{
  "manifest_version": 3,
  "name": "ExtViaNats",
  "version": "0.1.0",
  "description": "Profile-scoped remote browser commands over local or cloud NATS, driven by MCP agents.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "cookies",
    "userScripts",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120",
  "options_page": "options.html",
  "action": {
    "default_title": "ExtViaNats connection settings"
  },
  "key": ""
}
